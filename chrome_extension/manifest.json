{
  "manifest_version": 3,
  "name": "条文スタディ",
  "version": "1.0",
  "description": "Webページ上の法令参照（特許法第29条など）にマウスを合わせると条文をポップアップ表示します",
  "permissions": [
    "storage",
    "contextMenus",
    "tabs"
  ],
  "host_permissions": [
    "https://laws.e-gov.go.jp/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    },
    "default_title": "条文スタディ"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["law-data.js", "cloze.js", "content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["search.html", "search.js", "law-data.js", "cloze.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
